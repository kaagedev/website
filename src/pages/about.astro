---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, REPO_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About — ${SITE_TITLE}`}
			description="The story and philosophy behind kaage (ಕಾಗೆ / 影), a BeOS-inspired NixOS remote web desktop."
		/>
	</head>
	<body>
		<Header />
		<main class="about-stage">
			<section class="be-window">
				<div class="be-tab-row">
					<div class="be-tab">
						<span class="be-close-box"></span>
						<span>About kaage (ಕಾಗೆ / 影)</span>
					</div>
				</div>
				<div class="be-frame">
					<h1>The Crow and the Shadow</h1>
					<p>
						<strong>kaage</strong> started from a simple frustration: having a capable Linux machine—a GPU rig,
						homelab, cloud computer, or Raspberry Pi—and still being forced into raw SSH terminals whenever
						away from the desk.
					</p>
					<p>
						The name is a bilingual pun: <strong>ಕಾಗೆ (<em>kāge</em>)</strong> is Kannada for
						<em>crow</em>—observant, clever, perched above your system—while <strong>影 (<em>kage</em>)</strong>
						is Japanese for <em>shadow</em>, the remote desktop projection that follows you across
						Tailscale to any browser or mobile device.
					</p>
					<p>
						Everything is built in <strong>Rust</strong> (including the WASM frontend—no TypeScript or
						JavaScript), runs on an <strong>LLM-generated NixOS</strong> host, ships with the
						Finder/BeOS-inspired <strong>Tracker</strong> file explorer, and keeps backups dead simple by
						syncing <code>~/appdata/&lt;appname&gt;</code> continuously to Cloudflare R2 or S3.
					</p>
					<p>
						<a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="be-btn be-btn-primary">
							View Source on GitHub →
						</a>
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-stage {
		max-width: 820px;
		margin: 0 auto;
		padding: 2rem 1rem 3rem;
	}
</style>
