---
import { REPO_URL } from '../consts';
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-left">
			<span class="footer-glyphs">ಕಾಗೆ · 影</span>
			<span class="footer-tagline">
				The crow perched on your workstation. The shadow desktop in your browser.
			</span>
		</div>
		<div class="footer-right">
			<a href="/#what">Overview</a>
			<a href="/#ai">AI &amp; LLMs</a>
			<a href="/#stack">Stack</a>
			<a href="/about">About</a>
			<a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
			<span class="footer-copy">
				&copy; {today.getFullYear()} <a href="https://linkedin.com/in/btbytes" target="_blank" rel="noopener noreferrer">Pradeep Gowda</a>
			</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		background: linear-gradient(180deg, rgba(14, 34, 61, 0.92) 0%, #091321 100%);
		border-top: 2px solid var(--be-yellow);
		color: #cbd5e1;
		padding: 1.5rem 1rem 2.2rem;
	}

	.footer-inner {
		max-width: 1180px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.footer-glyphs {
		font-family: var(--font-kannada);
		font-weight: 700;
		color: var(--be-yellow);
		font-size: 1.05rem;
		letter-spacing: 0.04em;
	}

	.footer-tagline {
		font-size: 0.88rem;
		color: #b7c8dd;
	}

	.footer-right {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		font-size: 0.86rem;
	}

	.footer-right a {
		color: #e2e8f0;
		text-decoration: none;
	}

	.footer-right a:hover {
		color: var(--be-yellow);
		text-decoration: underline;
	}

	.footer-copy {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: #8ca3bf;
	}
</style>
