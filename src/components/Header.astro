---
import { REPO_URL } from '../consts';
---

<header class="deskbar">
	<div class="deskbar-inner">
		<a href="/" class="brand-leaf" aria-label="kaage home">
			<img src="/favicon.svg" alt="" width="20" height="20" class="brand-icon" />
			<span class="brand-name">kaage</span>
			<span class="brand-glyphs" aria-hidden="true">ಕಾಗೆ · 影</span>
		</a>

		<nav class="deskbar-tabs" aria-label="Primary navigation">
			<a href="/#what" class="desk-tab"><span class="tab-tag">[OS]</span> Overview</a>
			<a href="/#cockpit" class="desk-tab"><span class="tab-tag">[UX]</span> Cockpit</a>
			<a href="/#security" class="desk-tab"><span class="tab-tag">[TS]</span> Tailscale</a>
			<a href="/#ai" class="desk-tab"><span class="tab-tag">[AI]</span> AI &amp; LLMs</a>
			<a href="/#storage" class="desk-tab"><span class="tab-tag">[R2]</span> Storage</a>
			<a href="/#stack" class="desk-tab"><span class="tab-tag">[&gt;_]</span> Stack</a>
		</nav>

		<div class="deskbar-tray">
			<span class="tray-chip" title="Built with Rust, WASM & NixOS">
				<span class="status-dot"></span>
				NixOS · WASM
			</span>
			<a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="tray-github">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="15" height="15">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
				<span>GitHub</span>
			</a>
		</div>
	</div>
</header>

<style>
	.deskbar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: linear-gradient(180deg, #eaeaea 0%, #d4d4d4 100%);
		border-bottom: 1.5px solid var(--be-border);
		box-shadow:
			inset 0 1px 0 #ffffff,
			0 2px 8px rgba(9, 19, 33, 0.35);
	}

	.deskbar-inner {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0.35rem 0.9rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
		flex-wrap: wrap;
	}

	.brand-leaf {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.25rem 0.65rem;
		background: linear-gradient(180deg, var(--be-yellow-hi) 0%, var(--be-yellow) 55%, #e5ad00 100%);
		border: 1.5px solid var(--be-border);
		box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.7);
		text-decoration: none;
		color: var(--crow-ink);
		font-weight: 700;
		font-size: 0.92rem;
	}

	.brand-icon {
		border-radius: 3px;
	}

	.brand-glyphs {
		font-family: var(--font-kannada);
		font-size: 0.82rem;
		font-weight: 700;
		opacity: 0.85;
		padding-left: 0.25rem;
		border-left: 1px solid rgba(9, 19, 33, 0.3);
	}

	.deskbar-tabs {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		flex-wrap: wrap;
	}

	.desk-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.26rem 0.58rem;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--crow-ink);
		text-decoration: none;
		background: linear-gradient(180deg, #f3f3f3 0%, #dadada 100%);
		border: 1px solid #6b7280;
		box-shadow: inset 1px 1px 0 #ffffff;
		transition: background 0.12s ease;
	}

	.desk-tab:hover {
		background: linear-gradient(180deg, #fff4bd 0%, var(--be-yellow) 100%);
		border-color: var(--be-border);
		color: var(--crow-ink);
	}

	.tab-tag {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: #2b5580;
	}

	.deskbar-tray {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.tray-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 0.24rem 0.55rem;
		background: #e6e8ec;
		border: 1px solid #8a8f98;
		box-shadow: inset 1px 1px 0 rgba(0, 0, 0, 0.08);
		color: var(--crow-ink);
	}

	.tray-github {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.26rem 0.62rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: #f8fafc;
		background: var(--crow-ink);
		border: 1px solid var(--be-border);
		text-decoration: none;
	}

	.tray-github:hover {
		background: #1a2d45;
		color: var(--be-yellow);
	}

	@media (max-width: 900px) {
		.tray-chip {
			display: none;
		}
	}

	@media (max-width: 680px) {
		.deskbar-tabs {
			display: none;
		}
	}
</style>
